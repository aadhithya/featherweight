        "type": "section",
        "text": "## PROPOSAL",
        "kind": "fixed",
        "alternatives": [],
        "conditions": [],
        "children": [
          {
            "type": "subsection",
            "text": "### I. BACKGROUND",
            "kind": "fixed",
            "alternatives": [],
            "conditions": [],
            "children": [
              {
                "type": "numbered_item",
                "text": "1. **Current Situation**",
                "kind": "fixed",
                "alternatives": [],
                "conditions": [],
                "children": [
                  {
                    "type": "bullet_point",
                    "text": "   - {{client_short_name}} tracks milk collection on paper route sheets.",
                    "kind": "generated",
                    "alternatives": [
                      "   - Larkspur sells through its web shop and {{client_short_name}} stores on separate stock systems.",
                      "   - Merriweather runs {{client_short_name}} clinics that book appointments by phone.",
                      "   - Oakmere dispatchers plan routes in spreadsheets."
                    ],
                    "conditions": [],
                    "children": []
                  },
                  {
                    "type": "bullet_point",
                    "text": "   - Reconciling the sheets with invoices takes two staff three days a month.",
                    "kind": "generated",
                    "alternatives": [
                      "   - Stock levels differ between channels by up to {{stock_diff_percentage}}.",
                      "   - Around {{missed_percentage}} of appointments are missed without notice.",
                      "   - Last-minute changes are phoned through to drivers."
                    ],
                    "conditions": [],
                    "children": []
                  },
                  {
                    "type": "bullet_point",
                    "text": "   - Producers have asked for payment statements within five days of month end.",
                    "kind": "generated",
                    "alternatives": [
                      "   - Customers are sometimes sold items that are out of stock."
                    ],
                    "conditions": [
                      {
                        "field": "has_additional_current_situation_detail",
                        "op": "=",
                        "value": "true"
                      }
                    ],
                    "children": []
                  }
                ]
              },
              {
                "type": "numbered_item",
                "text": "2. **Objective**",
                "kind": "fixed",
                "alternatives": [],
                "conditions": [],
                "children": [
                  {
                    "type": "bullet_point",
                    "text": "   - Replace the route sheets with a mobile collection app.",
                    "kind": "generated",
                    "alternatives": [
                      "   - Give every channel one live view of stock.",
                      "   - Let patients book and change appointments online.",
                      "   - Plan and amend routes in one tool."
                    ],
                    "conditions": [],
                    "children": []
                  },
                  {
                    "type": "bullet_point",
                    "text": "   - Produce producer statements automatically.",
                    "kind": "generated",
                    "alternatives": [
                      "   - Cut oversells to below {{oversell_target_percentage}} of orders.",
                      "   - Send reminders by text message.",
                      "   - Push changes to drivers within one minute."
                    ],
                    "conditions": [],
                    "children": []
                  }
                ]
              },
              {
                "type": "numbered_item",
                "text": "3. **Timing**",
                "kind": "fixed",
                "alternatives": [],
                "conditions": [
                  {
                    "field": "has_timing_section",
                    "op": "=",
                    "value": "true"
                  }
                ],
                "children": [
                  {
                    "type": "bullet_point",
                    "text": "   - The system must be live before the autumn season.",
                    "kind": "generated",
                    "alternatives": [],
                    "conditions": [],
                    "children": []
                  }
                ]
              }
            ]
          },
          {
            "type": "subsection",
            "text": "### II. SCOPE OF WORK",
            "kind": "fixed",
            "alternatives": [],
            "conditions": [],
            "children": [
              {
                "type": "numbered_item",
                "text": "1. **Mobile Collection App**",
                "kind": "generated",
                "alternatives": [
                  "1. **Stock Hub**",
                  "1. **Online Booking**",
                  "1. **Route Planner**"
                ],
                "conditions": [],
                "children": [
                  {
                    "type": "bullet_point",
                    "text": "   - Driver app for iOS and Android with offline capture.",
                    "kind": "generated",
                    "alternatives": [
                      "   - Central stock service with an API for the web shop and the stores.",
                      "   - Patient portal for booking, changing and cancelling.",
                      "   - Planning view with drag and drop re-assignment."
                    ],
                    "conditions": [],
                    "children": []
                  },
                  {
                    "type": "bullet_point",
                    "text": "   - Volume and quality readings recorded at each farm.",
                    "kind": "generated",
                    "alternatives": [
                      "   - Reservation of items during checkout.",
                      "   - Calendar sync for clinicians.",
                      "   - Delivery windows and vehicle capacity respected."
                    ],
                    "conditions": [],
                    "children": []
                  }
                ]
              },
              {
                "type": "numbered_item",
                "text": "2. **Statement Engine**",
                "kind": "generated",
                "alternatives": [
                  "2. **Store Integration**",
                  "2. **Reminders**",
                  "2. **Driver Notifications**"
                ],
                "conditions": [],
                "children": [
                  {
                    "type": "bullet_point",
                    "text": "   - Monthly producer statements generated as PDF.",
                    "kind": "generated",
                    "alternatives": [
                      "   - Connectors for the point-of-sale systems of all {{store_count}} stores.",
                      "   - Text message reminders {{reminder_time_1}} and {{reminder_time_2}} hours before an appointment.",
                      "   - Instant push of route changes to the driver app."
                    ],
                    "conditions": [],
                    "children": []
                  },
                  {
                    "type": "bullet_point",
                    "text": "   - Export to the existing accounting package.",
                    "kind": "generated",
                    "alternatives": [],
                    "conditions": [
                      {
                        "field": "has_secondary_scope_deliverable",
                        "op": "=",
                        "value": "true"
                      }
                    ],
                    "children": []
                  }
                ]
              },
              {
                "type": "numbered_item",
                "text": "3. **Data Migration**",
                "kind": "generated",
                "alternatives": [
                  "3. **Reporting**",
                  "3. **Reception Dashboard**"
                ],
                "conditions": [
                  {
                    "field": "has_third_scope_item",
                    "op": "=",
                    "value": "true"
                  }
                ],
                "children": [
                  {
                    "type": "bullet_point",
                    "text": "   - Import of {{migration_history_period}} of route history.",
                    "kind": "generated",
                    "alternatives": [
                      "   - Daily variance report by channel.",
                      "   - Live view of the day's appointments for each clinic."
                    ],
                    "conditions": [],
                    "children": []
                  },
                  {
                    "type": "bullet_point",
                    "text": "   - Validation report for every imported producer.",
                    "kind": "generated",
                    "alternatives": [
                      "   - Alerts when a product falls below its safety stock.",
                      "   - Waiting list that offers freed slots automatically."
                    ],
                    "conditions": [],
                    "children": []
                  }
                ]
              }
            ]
