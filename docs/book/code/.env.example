# Copy this file to `.env` and set the key of the model you use. The container gets only the variables below.
# The book's code uses Gemini unless a chapter says otherwise.
GOOGLE_API_KEY=
# Only for the chapters that use Claude.
ANTHROPIC_API_KEY=
# Only if you try OpenAI (the image does not install the extra: see README.md).
OPENAI_API_KEY=
# Set INFO to see what the runner does, line by line.
FTW_LOG_LEVEL=
