# Copy to .env (gitignored) and fill in.
GOOGLE_API_KEY=

ANTHROPIC_API_KEY=

OPENAI_API_KEY=

# Max agent calls (model attempts) running at once. Optional; default 10.
FTW_MAX_CONCURRENT_ATTEMPTS=10

# How far agents may launch agents. Optional. Depth: most agents in one chain (default 3); launches: most per attempt (default 10).
FTW_MAX_AGENT_DEPTH=3
FTW_MAX_AGENT_LAUNCHES=10

# A read-only GitHub token, for examples/mcp. See examples/mcp/README.md.
GITHUB_TOKEN=
